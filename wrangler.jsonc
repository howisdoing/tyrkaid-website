{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tyrkaid-website",
  "main": "./worker.js",
  "compatibility_date": "2026-10-13",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/products",
      "/products/*",
      "/categories/*",
      "/news",
      "/news/*",
      "/about",
      "/contact",
      "/admin"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "industrial-catalog-db",
      "database_id": "fae4447c-5c95-4030-b0c3-aecc3e60a487"
    }
  ]
}
